    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference(\"System.Windows.Forms\")\r\nfrom System.Windows.Forms import Form, ComboBox, DialogResult, ComboBoxStyle, FormStartPosition, Button\r\n\r\n# List of options\r\noptions = [\"Craddys Parameters\", \"Aldi Parameters\"]\r\n\r\n# Create a form\r\nform = Form()\r\nform.Text = \"Select an Option\"\r\nform.Width = 250\r\nform.Height = 150\r\nform.StartPosition = FormStartPosition.CenterScreen\r\n\r\n# Create a dropdown (ComboBox)\r\ncombo = ComboBox()\r\ncombo.Width = 200\r\ncombo.Top = 20\r\ncombo.Left = 20\r\ncombo.DropDownStyle = ComboBoxStyle.DropDownList\r\n\r\n# Add items to the dropdown\r\nfor item in options:\r\n    combo.Items.Add(item)\r\n\r\n# Set default selection\r\ncombo.SelectedIndex = 0\r\n\r\n# Add dropdown to the form\r\nform.Controls.Add(combo)\r\n\r\n# Add an OK button\r\nok_button = Button()\r\nok_button.Text = \"OK\"\r\nok_button.Top = 60\r\nok_button.Left = 80\r\nok_button.DialogResult = DialogResult.OK\r\nform.Controls.Add(ok_button)\r\nform.AcceptButton = ok_button\r\n\r\n# Show the form as a dialog\r\nresult = form.ShowDialog()\r\n\r\n# Output the selected item if OK is clicked\r\nif result == DialogResult.OK:\r\n    OUT = combo.SelectedItem\r\nelse:\r\n    OUT = None\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "c83aa89e0ac842478150a803e345dcb0",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "6cf6c41044a94f1aa469813cdfa7e968",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "1cef111078394879b39b07f63717c484",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
