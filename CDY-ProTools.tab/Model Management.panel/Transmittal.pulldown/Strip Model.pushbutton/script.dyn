  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Boilerplate text\r\nimport clr\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Current doc/app/ui\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Define list/unwrap list functions\r\ndef uwlist(input):\r\n    result = input if isinstance(input, list) else [input]\r\n    return UnwrapElement(result)\r\n\r\n# Preparing input from dynamo to revit\r\nsheets = uwlist(IN[0])\r\n\r\n# Get revision sequences and revisions\r\nrevSeqs = FilteredElementCollector(doc).OfClass(RevisionNumberingSequence).ToElements()\r\nrevIds  = Revision.GetAllRevisionIds(doc)\r\nrevs    = [doc.GetElement(i) for i in revIds]\r\n\r\nAllDates = []\r\nDeDupDates = []\r\nfor r in revs:\r\n    AllDates += [r.RevisionDate]\r\n    if r.RevisionDate not in DeDupDates:\r\n        DeDupDates += [r.RevisionDate]\r\n        \r\nNonUniqueDates = []\r\nindexx = 0\r\nfor r in revs:\r\n    \r\n    if indexx == 0:\r\n        indexx += 1\r\n        continue\r\n        \r\n    if r.RevisionDate == revs[indexx -1].RevisionDate:\r\n        if r.RevisionDate not in NonUniqueDates:\r\n            NonUniqueDates += [r.RevisionDate] \r\n    indexx += 1\r\n\r\n# Empty variable lists to store to\r\nrevSeqNames, revCharSeqs = [],[]\r\n\r\n# Get sequence names and characters\r\nfor r in revs:\r\n    # Get sequence\r\n    rsId = r.RevisionNumberingSequenceId\r\n    rs   = doc.GetElement(rsId)\r\n    # Append the name and start a sequence\r\n    # keep your original choice of rs.Name so existing logic & indexing remain unchanged\r\n    revSeqNames.append(rs.Name)\r\n    charSequence = []\r\n    # Get sequence characters for numeric...\r\n    if rs.NumberType == RevisionNumberType.Numeric:\r\n        settings  = rs.GetNumericRevisionSettings()\r\n        minDigits = settings.MinimumDigits\r\n        prefix    = settings.Prefix\r\n        suffix    = settings.Suffix\r\n        for n in range(settings.StartNumber,99,1):\r\n            char_str = str(n)\r\n            pad_str  = char_str.rjust(minDigits,\"0\")\r\n            char_seq = prefix + pad_str + suffix\r\n            charSequence.append(char_seq)\r\n    # ... or Alphanumeric\r\n    else:\r\n        settings = rs.GetAlphanumericRevisionSettings()\r\n        prefix    = settings.Prefix\r\n        suffix    = settings.Suffix\r\n        for a in settings.GetSequence():\r\n            char_seq = prefix + a + suffix\r\n            charSequence.append(char_seq)\r\n    # Append the character sequence\r\n    revCharSeqs.append(charSequence)\r\n\r\n# -------------------------\r\n# Robust manual override detection helpers\r\n# -------------------------\r\n\r\ndef _safe_lookup_param_as_string(elem, param_name):\r\n    \"\"\"Return parameter string if present, otherwise None (defensive).\"\"\"\r\n    try:\r\n        p = elem.LookupParameter(param_name)\r\n        if p:\r\n            v = p.AsString()\r\n            if v:\r\n                return v\r\n    except Exception:\r\n        pass\r\n    return None\r\n\r\ndef _gather_text_candidates_from_element(elem):\r\n    \"\"\"Return a list of string candidates to inspect on an element (Name, SequenceName, Description,\r\n       and a few common parameter names). Defensive — works whether attribute exists or not.\"\"\"\r\n    candidates = []\r\n    try:\r\n        # element.Name exists often (Element.Name)\r\n        n = getattr(elem, \"Name\", None)\r\n        if n:\r\n            candidates.append(str(n))\r\n    except Exception:\r\n        pass\r\n    try:\r\n        # some API versions expose SequenceName\r\n        sn = getattr(elem, \"SequenceName\", None)\r\n        if sn:\r\n            candidates.append(str(sn))\r\n    except Exception:\r\n        pass\r\n    try:\r\n        desc = getattr(elem, \"Description\", None)\r\n        if desc:\r\n            candidates.append(str(desc))\r\n    except Exception:\r\n        pass\r\n    # common parameter names that might store a description\r\n    for pn in (\"Description\", \"Sequence Description\", \"SequenceDescription\", \"Notes\", \"Comments\"):\r\n        v = _safe_lookup_param_as_string(elem, pn)\r\n        if v:\r\n            candidates.append(str(v))\r\n    return candidates\r\n\r\ndef is_manual_override_sequence(revision_elem, seq_elem):\r\n    \"\"\"Return True if either the revision or the sequence contains the string 'MANUAL OVERRIDE'\r\n       in any plausible property/parameter (case-insensitive).\"\"\"\r\n    needle = \"MANUAL OVERRIDE\"\r\n    # gather texts from sequence\r\n    seq_texts = _gather_text_candidates_from_element(seq_elem)\r\n    # gather texts from revision\r\n    rev_texts = _gather_text_candidates_from_element(revision_elem)\r\n    # test every candidate\r\n    for t in seq_texts + rev_texts:\r\n        try:\r\n            if t and needle in t.upper():\r\n                return True\r\n        except Exception:\r\n            pass\r\n    return False\r\n\r\n# -------------------------\r\n# Get revision sequences per sheet (original logic preserved; manual override hooking added)\r\n# -------------------------\r\nrowsOut = []\r\nsep = \"\\t\"\r\n\r\nSeqNo = 0\r\nSeqDate = 0\r\n\r\n# Option: enable debug to dump sequence / revision text candidates to OUT for troubleshooting\r\nDEBUG_MANUAL_CHECK = False\r\ndebug_list = []\r\n\r\nfor s in sheets:\r\n    trackRevs = []\r\n    sheetRevs = s.GetAllRevisionIds()\r\n    rowOut = \"\"\r\n    rowOut += s.SheetNumber + sep + s.Name + sep\r\n\r\n    # store the most-recent revision character seen for this sheet while iterating\r\n    latestRevChar = \"\"\r\n\r\n    # For each revision in the document\r\n    for i in revIds:\r\n        # Check if the sheet has it\r\n        DupeDateCounter = 0\r\n        d = \"\"\r\n\r\n        r    = doc.GetElement(i)\r\n        rsId = r.RevisionNumberingSequenceId\r\n        rs   = doc.GetElement(rsId)\r\n        rsn  = rs.Name\r\n        SeqNo = r.SequenceNumber\r\n        SeqDate = r.RevisionDate \r\n\r\n        # Collect debug data if requested\r\n        if DEBUG_MANUAL_CHECK:\r\n            debug_list.append((i.IntegerValue if hasattr(i, \"IntegerValue\") else str(i),\r\n                               rsn,\r\n                               _gather_text_candidates_from_element(rs),\r\n                               _gather_text_candidates_from_element(r)))\r\n\r\n        # Detect manual override by checking both the sequence AND the revision for the string\r\n        manual_override = is_manual_override_sequence(r, rs)\r\n\r\n        # If this sequence is a manual override, write the last tracked revision for this sheet into this column\r\n        if manual_override:\r\n            if latestRevChar:\r\n                #d = latestRevChar + sep\r\n                d = sep\r\n            else:\r\n                # explicit blank cell (no previous revision recorded yet)\r\n                d = \"\" + sep\r\n\r\n        else:\r\n            # non-manual sequences - preserve your original logic exactly but also update latestRevChar\r\n            if i in sheetRevs:\r\n                # Get the sequence Id name and get its name\r\n                i_sq = revSeqNames.index(rsn)\r\n                # Find out how many times the sequence occured so far\r\n                i_ch = trackRevs.count(rsn)\r\n                # Find Seq no, revision date and reset ArtLocation to =\r\n                ArtificialLocation = 0\r\n                LastDupDateLocation = 0\r\n                # Then track the sequence\r\n                trackRevs.append(rsn)            \r\n\r\n                # base char for this sequence occurrence\r\n                base_char = revCharSeqs[i_sq][i_ch]\r\n\r\n                # Check if sequence is a duplicated date\r\n                if SeqDate in NonUniqueDates:\r\n                    # Find location of SeqDate in DeDupDates List. Set as ArtLocation \r\n                    ArtificialLocation = DeDupDates.index(SeqDate)\r\n                    # Find location of last SeqDate in DeDupDates List.\r\n                    LastDupDateLocation = len(AllDates) - 1 - AllDates[::-1].index(SeqDate)\r\n                    # Add 1 because Seq start at 1, however Python Index start at 0\r\n                    ArtificialLocation += 1\r\n                    LastDupDateLocation += 1\r\n                    # Check if first occurance of dupe date\r\n                    if ArtificialLocation == SeqNo - DupeDateCounter:\r\n                        # true\r\n                        # Get the sequence character\r\n                        d = base_char\r\n                        #increment dupe counter\r\n                        DupeDateCounter += 1\r\n                    else:\r\n                        d += \"\"\r\n\r\n                    #check if last occurance of dupe date\r\n                    if LastDupDateLocation == SeqNo - DupeDateCounter:\r\n                        # output with trailing sep\r\n                        d = base_char + sep\r\n                        DupeDateCounter += 1\r\n                    else:\r\n                        d = base_char\r\n                        #increment dupe counter\r\n                        DupeDateCounter += 1\r\n                else: \r\n                    # If date is not a dupe date    \r\n                    # Get the sequence character, then track the sequence    \r\n                    d = base_char + sep\r\n\r\n                # --- IMPORTANT: update latest tracked revision for this sheet ---\r\n                latestRevChar = base_char\r\n\r\n            else:\r\n                # If the revision is not on the sheet, preserve original behaviour\r\n                if SeqDate in NonUniqueDates:\r\n                    # Find location of SeqDate in DeDupDates List. Set as ArtLocation \r\n                    ArtificialLocation = DeDupDates.index(SeqDate)\r\n                    LastDupDateLocation = len(AllDates) - 1 - AllDates[::-1].index(SeqDate)\r\n                    # Add 1 because Seq start at 1, however Python Index start at 0\r\n                    ArtificialLocation += 1\r\n                    LastDupDateLocation += 1\r\n                    # Check if first occurance of dupe date\r\n                    if ArtificialLocation == SeqNo - DupeDateCounter:\r\n                        # true\r\n                        d = \"\"\r\n                        #increment dupe counter\r\n                        DupeDateCounter += 1\r\n                    else:\r\n                        # no output\r\n                        d = \"\"\r\n                    \r\n                    if LastDupDateLocation == SeqNo - DupeDateCounter:\r\n                        # output blank cell with sep\r\n                        d = \"\" + sep\r\n                        DupeDateCounter += 1\r\n                    else:\r\n                        d = \"\"\r\n                        DupeDateCounter += 1\r\n                else:\r\n                # If Rev not on sheet, no output + tab\r\n                    d = \"\" + sep\r\n\r\n        # append if non-empty (keeps your original behaviour for columns)\r\n        if d != \"\":\r\n            rowOut += d \r\n    # Add the value to the end\r\n    rowsOut.append(rowOut)\r\n\r\n# Make the top header\r\nheader = \"Document No.\" + sep + \"Document Name\" + sep + sep.join(DeDupDates) + sep\r\nrowsOut.insert(0,header)\r\n\r\n# If debug enabled, return debug list as second output for inspection\r\nif DEBUG_MANUAL_CHECK:\r\n    OUT = (rowsOut, debug_list)\r\nelse:\r\n    OUT = rowsOut\r\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "ba14368bd41f44e9b2c8738df62dd52b",
