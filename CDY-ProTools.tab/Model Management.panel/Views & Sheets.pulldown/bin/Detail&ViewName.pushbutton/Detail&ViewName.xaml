<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viewport ↔ Detail Tool" Height="260" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#0078D7">
                <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
                <TextBlock Text="Viewport ↔ Detail Number Tool" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="White" Margin="10,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="cancelBtn" Width="90" Height="28" Margin="5" Content="Cancel"
                    Background="#EEE" Foreground="#222"
                    BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

        <!-- Operation Choices -->
        <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0,20,0,0" HorizontalAlignment="Center">

            <TextBlock Text="Select an Operation:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <Button Name="btnViewToDetail" Width="220" Height="50" Margin="5"
                        Content="View Name → Detail Number"
                        Background="#E1F5FE" Foreground="#0078D7" FontWeight="SemiBold"
                        BorderBrush="#81D4FA" BorderThickness="1" Cursor="Hand"/>
                <Button Name="btnDetailToView" Width="220" Height="50" Margin="5"
                        Content="Detail Number → View Name"
                        Background="#FFF3E0" Foreground="#FB8C00" FontWeight="SemiBold"
                        BorderBrush="#FFB74D" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

    </DockPanel>
</Window>

