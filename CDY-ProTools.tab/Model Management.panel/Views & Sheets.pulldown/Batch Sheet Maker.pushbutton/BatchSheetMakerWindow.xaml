<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        Width="675" Height="500" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        HorizontalContentAlignment="Center"
        Title="Batch Sheet Maker">
    <DockPanel Margin="10">

        <TextBlock DockPanel.Dock="Top">
            Enter list of sheet number and names in this format:<LineBreak />
            <Bold>sheet-number</Bold>  TAB  <Bold>sheet-name</Bold> (e.g. A311 <Run FontSize="18" Text="⇥"/> SHEET NAME)<LineBreak />
            Multiple sheet with identical names could be listed with sheet number ranges:<LineBreak />
            <Bold>Range of Sheet Numbers:</Bold>   e.g. A103--A106 or A103::A106<LineBreak />
            <Bold>List of Sheet Numbers:</Bold>   e.g. A104,A105 or A104;A105
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom">

            <!-- Options: Sheets / Placeholders / Excel Mode -->
            <WrapPanel Margin="0,5,0,0">
                <RadioButton x:Name="sheet_cb" GroupName="sheetoptions"
                             Margin="10,5,0,5"
                             IsChecked="True">
                    Create Sheets
                </RadioButton>

                <CheckBox x:Name="NamingProtocol_cb"
                          Margin="20,5,0,5"
                          IsChecked="False"
                          VerticalAlignment="Center">
                    Use Craddy's Naming Parameters (XXXX-CDY-XX-XX-DR-S-XXXX)
                </CheckBox>
            </WrapPanel>

            <Button Content="Create" Margin="0,10,0,0"
                    Height="24"
                    Click="create_sheets"/>
        </StackPanel>

        <TextBox x:Name="sheets_tb"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 Margin="0 10 0 0"
                 FontFamily="Courier New" FontSize="14"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
