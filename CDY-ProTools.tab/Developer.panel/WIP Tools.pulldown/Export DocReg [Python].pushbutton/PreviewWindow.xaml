<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Sheets Preview" Height="800" Width="1500" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel Margin="10,10,10,0" DockPanel.Dock="Top">
            <TextBlock Text="Sheet Preview" FontWeight="Bold" FontSize="14"/>
            <Button x:Name="copy_btn" Content="Copy Table to Clipboard" Width="200" Margin="0,5,0,5"/>
        </StackPanel>

        <DataGrid x:Name="sheets_lb"
                  AutoGenerateColumns="False"
                  Margin="10"
                  CanUserSortColumns="True"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Index" Binding="{Binding index}" Width="50"/>
                <DataGridTextColumn Header="Sheet Number" Binding="{Binding sheet_number}" Width="120"/>
                <DataGridTextColumn Header="Sheet Name" Binding="{Binding sheet_name}" Width="400"/>
                <DataGridTemplateColumn Header="Revisions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding revisions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="2,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Filename" Binding="{Binding print_filename}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
