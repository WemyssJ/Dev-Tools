<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Number Piles" Height="325" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#0078D7">
            <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
            <TextBlock Text="Number Element" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="cancelBtn" Width="90" Height="28" Margin="5" Content="Cancel"
                    Background="#EEE" Foreground="#222"
                    BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
            <Button Name="okBtn" Width="120" Height="28" Margin="5" Content="Start Numbering"
                    Background="#0078D7" Foreground="White" FontWeight="SemiBold"
                    BorderBrush="#005A9E" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

        <!-- Form Content -->
        <Border DockPanel.Dock="Top" Padding="20" Margin="0,10,0,0"
                Background="White" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">

            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Prefix -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Prefix (e.g. P):"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,5"/>
                <TextBox Name="prefixBox" Grid.Row="0" Grid.Column="1"
                         Width="150" Height="25" Text="P" Margin="0,0,0,10"/>

                <!-- Padding -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Padding (e.g. 3 for 001):"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,5"/>
                <TextBox Name="padBox" Grid.Row="1" Grid.Column="1"
                         Width="150" Height="25" Text="3" Margin="0,0,0,10"/>

                <!-- Category -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Element Type:"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,5"/>
                <ComboBox Name="catCombo" Grid.Row="2" Grid.Column="1"
                          Width="150" Height="25" Margin="0,0,0,10"/>

            </Grid>
        </Border>
    </DockPanel>
</Window>
