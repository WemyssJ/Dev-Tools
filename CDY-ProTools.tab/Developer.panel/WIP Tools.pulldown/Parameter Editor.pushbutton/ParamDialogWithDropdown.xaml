<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit Parameter" Height="375" Width="400"
    WindowStartupLocation="CenterScreen"
    Background="#FAFAFA" Foreground="#222"
    ResizeMode="NoResize"
    FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#0078D7">
            <TextBlock Text="Edit Parameter" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="White" Margin="10,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnCancel" Width="90" Height="28" Margin="5" Content="Cancel"
                    Background="#EEE" Foreground="#222"
                    BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
            <Button x:Name="btnOk" Width="90" Height="28" Margin="5" Content="OK"
                    Background="#0078D7" Foreground="White" FontWeight="SemiBold"
                    BorderBrush="#005A9E" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

        <!-- Form Content -->
        <Border DockPanel.Dock="Top" Padding="20" Margin="0,10,0,0"
                Background="White" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
            <Grid Margin="0,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Parameter ComboBox -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
                    <TextBlock Text="Select Parameter:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbParameters" Height="25"/>
                </StackPanel>

                <!-- Parameter Value TextBox -->
                <StackPanel Grid.Row="1" Orientation="Vertical">
                    <TextBlock Text="Parameter Value:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtParameterValue" AcceptsReturn="True" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" Height="80"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
