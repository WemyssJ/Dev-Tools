<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Revision Tool" Height="420" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#0078D7">
            <TextBlock Text="Master Revision Tool" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="White" Margin="10,0"/>
        </StackPanel>

        <!-- Cancel Button -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="cancelBtn" Width="90" Height="28" Margin="5" Content="Cancel"
                    Background="#EEE" Foreground="#222"
                    BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

        <!-- Action Buttons -->
        <Border DockPanel.Dock="Top" Padding="20" Margin="0,10,0,0"
                Background="White" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">

                <TextBlock Text="Select an Action:" Margin="0,0,0,15" FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Name="btnAdd" Content="➕ Add Revision to Sheets" Width="205" Height="50" Margin="5"
                            Background="#E1F5FE" Foreground="#0078D7" FontWeight="SemiBold"
                            BorderBrush="#81D4FA" BorderThickness="1" Cursor="Hand"/>
                    <Button Name="btnRemove" Content="➖ Remove Revision from Sheets" Width="205" Height="50" Margin="5"
                            Background="#FCE4EC" Foreground="#C2185B" FontWeight="SemiBold"
                            BorderBrush="#F48FB1" BorderThickness="1" Cursor="Hand"/>
                    <Button Name="btnFind" Content="🔍 Find Sheets with Revision" Width="205" Height="50" Margin="5"
                            Background="#EDE7F6" Foreground="#512DA8" FontWeight="SemiBold"
                            BorderBrush="#B39DDB" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Name="btnIssued" Content="✅ Set Revisions as Issued" Width="205" Height="50" Margin="5"
                            Background="#E8F5E9" Foreground="#2E7D32" FontWeight="SemiBold"
                            BorderBrush="#A5D6A7" BorderThickness="1" Cursor="Hand"/>
                    <Button Name="btnHideClouds" Content="☁️ Hide All Revision Clouds" Width="205" Height="50" Margin="5"
                            Background="#FFF3E0" Foreground="#FB8C00" FontWeight="SemiBold"
                            BorderBrush="#FFB74D" BorderThickness="1" Cursor="Hand"/>
                    <Button Name="btnSheetSet" Content="📑 Create Revision Sheet Set" Width="205" Height="50" Margin="5"
                            Background="#FFFDE7" Foreground="#F9A825" FontWeight="SemiBold"
                            BorderBrush="#FFF59D" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>

                <!-- New row for Copy Revisions button (spaced slightly below) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Name="btnCopy" Content="📋 Copy Revisions to Open Models" Width="430" Height="44" Margin="5"
                            Background="#E3F2FD" Foreground="#1565C0" FontWeight="SemiBold"
                            BorderBrush="#90CAF9" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </Border>

    </DockPanel>
</Window>
