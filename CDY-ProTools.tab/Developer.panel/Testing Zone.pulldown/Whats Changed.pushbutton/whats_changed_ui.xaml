<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's Changed?" Height="550" Width="540"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        Topmost="False"
        FontFamily="Mona-Sans Light" FontSize="13">

  <DockPanel Margin="10">

    <!-- Top Banner with large white "?" icon -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48" Background="#0078D7" Margin="0,0,0,10">
        <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
        <TextBlock Text="What's Changed?" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
    </StackPanel>

    <!-- Bottom Buttons -->
    <Grid DockPanel.Dock="Bottom" Margin="0,15,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Config Buttons -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Visible">
            <Button x:Name="saveConfigBtn" Content="💾 Save Config" Width="140" Height="28" Margin="5,0,0,0"
                    Background="#E3F2FD" Foreground="#1565C0" FontWeight="SemiBold"
                    BorderBrush="#90CAF9" BorderThickness="1" Cursor="Hand"/>
            <Button x:Name="loadConfigBtn" Content="📂 Load Config" Width="140" Height="28" Margin="5,0,0,0"
                    Background="#E3F2FD" Foreground="#1565C0" FontWeight="SemiBold"
                    BorderBrush="#90CAF9" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

        <!-- Cancel / Confirm Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
            <Button x:Name="cancelBtn" Width="90" Height="28" Margin="5" Content="Cancel"
                    Background="#EEE" Foreground="#222" BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
            <Button x:Name="okBtn" Width="90" Height="28" Margin="5" Content="Confirm"
                    Background="#0078D7" Foreground="White" FontWeight="SemiBold"
                    BorderBrush="#005A9E" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>
    </Grid>

    <!-- Action Toggle Buttons -->
    <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" CornerRadius="6" Background="White" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Select Action:" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="importToggle" Width="140" Height="36" Margin="5" IsChecked="True"
                              Background="#DDEFFF" Foreground="#005A9E" FontWeight="SemiBold" BorderBrush="#81C2F2" BorderThickness="1" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📥" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Import JSON" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="exportToggle" Width="140" Height="36" Margin="5"
                              Background="#FFF5E0" Foreground="#B95C00" FontWeight="SemiBold" BorderBrush="#FFC382" BorderThickness="1" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📤" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Export JSON" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- Export Form -->
    <Border x:Name="exportForm" DockPanel.Dock="Top" Padding="18" Margin="0,0,0,10" Background="White"
            CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Effect="{DynamicResource DropShadowEffect}" Visibility="Collapsed">
        <StackPanel>
            <TextBlock Text="Export Options:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Job Number -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Job Number:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="jobNumberBox" Grid.Row="0" Grid.Column="1" Width="250" Height="28" Text=""
                        Background="#FAFAFA" BorderBrush="#CCC" BorderThickness="1" Padding="2" VerticalContentAlignment="Center"
                        Margin="0,0,10,0"/>

                <!-- Discipline -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Discipline:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="disciplineBox" Grid.Row="1" Grid.Column="1" Width="250" Height="28"
                          Background="#FAFAFA" BorderBrush="#CCC" BorderThickness="1" Padding="2" VerticalContentAlignment="Center"
                          Margin="0,0,10,0"/>

                <!-- Job Name -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Job Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="jobBox" Grid.Row="2" Grid.Column="1" Width="250" Height="28" Text="N/A"
                        Background="#FAFAFA" BorderBrush="#CCC" BorderThickness="1" Padding="2" VerticalContentAlignment="Center"
                        Margin="0,0,10,0"/>

                <!-- Rev / Date -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Rev / Date:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="revisionBox" Grid.Row="3" Grid.Column="1" Width="250" Height="28" Text="P00"
                        Background="#FAFAFA" BorderBrush="#CCC" BorderThickness="1" Padding="2" VerticalContentAlignment="Center"
                        Margin="0,0,10,0"/>

                <!-- Model Source -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Model Source:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="modelSourceBox" Grid.Row="4" Grid.Column="1" Width="250" Height="28"
                          Background="#FAFAFA" BorderBrush="#CCC" BorderThickness="1" Padding="2" VerticalContentAlignment="Center"
                          Margin="0,0,10,0"/>
            </Grid>

            <TextBlock x:Name="anticipatedFileName" Margin="0,12,0,0" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>



    <!-- Import Form / Color Pickers -->
    <Border x:Name="importForm" DockPanel.Dock="Top" Padding="18" Margin="0,0,0,10" Background="White"
            CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Effect="{DynamicResource DropShadowEffect}">
        <StackPanel>
            <TextBlock Text="Select Override Colors:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="New:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="newRect" Grid.Row="0" Grid.Column="1" Width="170" Height="28" Background="#00FF00" CornerRadius="4"
                        BorderBrush="#888" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,10,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Moved:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="movedRect" Grid.Row="1" Grid.Column="1" Width="170" Height="28" Background="#FFA500" CornerRadius="4"
                        BorderBrush="#888" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,10,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Changed:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="changedRect" Grid.Row="2" Grid.Column="1" Width="170" Height="28" Background="#0064FF" CornerRadius="4"
                        BorderBrush="#888" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>
        </StackPanel>
    </Border>


  </DockPanel>
</Window>


