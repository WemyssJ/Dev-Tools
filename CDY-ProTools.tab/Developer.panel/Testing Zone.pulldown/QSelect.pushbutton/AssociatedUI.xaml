<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QSelect" Height="325" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="50" Background="#0078D7">
            <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
            <TextBlock Text="Master Selection Tool" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="White" Margin="10,0"/>
        </StackPanel>

        <!-- Action Buttons -->
        <Border DockPanel.Dock="Top" Padding="20" Margin="0,10,0,0"
                Background="White" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">

                <TextBlock Text="Select an Action:" Margin="0,0,0,15" FontWeight="SemiBold" FontSize="14"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Name="btnWorkPlane" Content="🔹 Select Framing by Work Plane" Width="220" Height="50" Margin="5"
                            Background="#E1F5FE" Foreground="#0078D7" FontWeight="SemiBold"
                            BorderBrush="#81D4FA" BorderThickness="1" Cursor="Hand"/>
                    <Button Name="btnLevel" Content="🔹 Select Elements by Level" Width="220" Height="50" Margin="5"
                            Background="#E8F5E9" Foreground="#2E7D32" FontWeight="SemiBold"
                            BorderBrush="#A5D6A7" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>

                <!-- Cancel Button -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Name="cancelBtn" Width="90" Height="28" Margin="5" Content="Cancel"
                            Background="#EEE" Foreground="#222"
                            BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </Border>

    </DockPanel>
</Window>
