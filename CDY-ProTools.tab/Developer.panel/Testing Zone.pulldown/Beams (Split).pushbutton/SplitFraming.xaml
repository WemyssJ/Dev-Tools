<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Split Framing at Reference Planes"
        Height="550" Width="575"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

  <DockPanel Margin="10">

    <!-- Top Banner -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48" Background="#0078D7" Margin="0,0,0,10">
        <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
        <TextBlock Text="Split" FontSize="16" FontWeight="Bold" Margin="10,10,6,10" VerticalAlignment="Center" Foreground="White"/>
        <TextBlock Text="Split Framing at Reference Planes" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
    </StackPanel>

    <!-- Action Buttons -->
    <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,10" CornerRadius="6" Background="White" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Steps:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <!-- Step 1 -->
            <Button x:Name="selectBeamsBtn" Width="500" Height="36" Margin="0,0,0,8"
                    Background="#E3F2FD" Foreground="#1565C0" FontWeight="SemiBold"
                    BorderBrush="#90CAF9" BorderThickness="1" Cursor="Hand">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="①" Margin="0,0,6,0" FontSize="14"/>
                    <TextBlock Text="Select Structural Framing" />
                    <TextBlock x:Name="beamCountText" Text="Selected: 0" FontStyle="Italic" Foreground="Gray" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- Step 2 -->
            <Button x:Name="selectSplittersBtn" Width="500" Height="36" Margin="0,0,0,8"
                    Background="#FFF5E0" Foreground="#B95C00" FontWeight="SemiBold"
                    BorderBrush="#FFC382" BorderThickness="1" Cursor="Hand">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="②" Margin="0,0,6,0" FontSize="14"/>
                    <TextBlock Text="Select Reference Line / Grid" />
                    <TextBlock x:Name="planeCountText" Text="Selected: 0" FontStyle="Italic" Foreground="Gray" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- Step 3 -->
            <Button x:Name="optionsBtn" Width="500" Height="36" Margin="0,0,0,0"
                    Background="#E8F5E9" Foreground="#2E7D32" FontWeight="SemiBold"
                    BorderBrush="#A5D6A7" BorderThickness="1" Cursor="Hand">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="③" Margin="0,0,6,0" FontSize="14"/>
                    <TextBlock Text="Set Options / Run" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>

    <!-- Options Form -->
    <Border x:Name="optionsPanel" DockPanel.Dock="Top" Padding="18" Margin="0,0,0,10" Background="White"
            CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Visibility="Collapsed">
        <StackPanel>
            <TextBlock Text="Split Options:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
            <CheckBox x:Name="showConsoleBox" Content="Show detailed console logs" IsChecked="True" Margin="0,0,0,4"/>
            <CheckBox x:Name="preserveParamsBox" Content="Preserve instance parameters" IsChecked="True" Margin="0,0,0,4"/>
            <CheckBox x:Name="disableJoinsBox" Content="Disable auto-joins on new beams" IsChecked="True" Margin="0,0,0,4"/>
            <Button x:Name="runSplitBtn" Width="140" Height="32" Margin="0,10,0,0"
                    Background="#0078D7" Foreground="White" FontWeight="SemiBold"
                    BorderBrush="#005A9E" BorderThickness="1" Cursor="Hand"
                    HorizontalAlignment="Left" Content="▶ Run Split"/>
        </StackPanel>
    </Border>

    <!-- Close Button -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
        <Button x:Name="closeBtn" Width="90" Height="28" Margin="5" Content="Close"
                Background="#EEE" Foreground="#222" BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
    </StackPanel>

  </DockPanel>
</Window>
