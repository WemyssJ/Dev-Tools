            </DrawingImage.Drawing>
        </DrawingImage>

        <SolidColorBrush x:Key="RevBGColor" Color="#FFEEEEEE"/>

        <!-- Default DataGrid cell style -->
        <Style x:Key="DefaultColumnStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="ToolTip" Value="{Binding tooltip}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding printable}" Value="False">
                    <Setter Property="Foreground" Value="#bdbdbd" />
                    <Setter Property="Background" Value="#f6f6f6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Centered DataGrid cell style -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DefaultColumnStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Hyperlink style for status bar -->
        <Style TargetType="{x:Type Hyperlink}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Section -->
        <StackPanel Margin="10,10,10,0" DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>

                <!-- Stack Document and Naming Protocol vertically -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch">

                    <!-- Document row -->
                    <Grid Height="24" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Polygon + label -->
                        <Grid Margin="0,0,10,0" Grid.Column="0">
                            <Viewbox Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas Width="150" Height="24">
                                    <Polygon Points="0,0 140,0 150,12 140,24 0,24"
                                            Fill="{DynamicResource pyRevitDarkBrush}"
                                            SnapsToDevicePixels="True"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Document" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,10,0" Foreground="White"/>
                        </Grid>

                        <ComboBox x:Name="DocumentsCombo" Grid.Column="1" VerticalAlignment="Stretch"/>
                    </Grid>

                    <!-- Naming Protocol row -->
                    <Grid Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,10,0" Grid.Column="0">
                            <Viewbox Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas Width="150" Height="24">
                                    <Polygon Points="0,0 140,0 150,12 140,24 0,24"
                                            Fill="{DynamicResource pyRevitDarkBrush}"
                                            SnapsToDevicePixels="True"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Naming Protocol" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,10,0" Foreground="White"/>
                        </Grid>

                        <ComboBox x:Name="NamingProtocolCombo" Grid.Column="1" VerticalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>

                <!-- Export button -->
                <Button x:Name="ExportButton" Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0">
                        <!-- Embedded Canvas icon -->
                        <Canvas Width="48" Height="48">
                            <Path Canvas.Top="8.25" Canvas.Left="6"
                                Data="m47.875 4.75 2.8-.062 2.692-.016 2.472-.028C58.501 5.083 59.393 5.869 61 8v2l2.887-.105 3.8-.082 3.762-.106c3.797.313 5.566.985 8.551 3.293 2.422 3.633 2.264 5.36 2.29 9.687l.02 2.046c.02 2.232.024 4.464.026 6.697l.02 4.66q.017 4.884.015 9.769c0 4.169.027 8.337.061 12.505.022 3.209.026 6.417.025 9.626q.005 2.304.027 4.61c.02 2.151.014 4.302.002 6.454l.008 3.707C81.904 86.63 80.762 88.275 78 91c-3.015 1.005-5.065 1.138-8.218 1.161l-3.227.03-3.485.012-3.583.017q-3.755.015-7.51.02c-3.83.01-7.659.041-11.489.073q-3.646.009-7.293.015l-3.472.038-3.246-.01-2.846.011C20.44 91.922 18.592 90.891 16 89c-2.422-3.633-2.264-5.36-2.29-9.687l-.02-2.046a887 887 0 0 1-.026-6.697l-.02-4.66q-.017-4.884-.015-9.769c0-4.169-.027-8.337-.061-12.505-.022-3.209-.026-6.417-.025-9.626a540 540 0 0 0-.027-4.61c-.02-2.151-.014-4.302-.002-6.454l-.008-3.707C14.096 15.37 15.238 13.725 18 11c3.56-1.187 6.438-1.097 10.188-1.062l3.855.027L35 10l.938-1.937C38.37 3.34 43.05 4.777 47.875 4.75M41 10l-1 5h15l1-4c-1.137-1.365-1.137-1.365-4.16-1.098l-3.903.036-3.91.027zm-21 7c-1.376 2.753-1.135 4.973-1.145 8.054l-.02 3.853-.003 4.183-.01 4.274q-.009 4.483-.007 8.966c0 3.831-.014 7.662-.031 11.494a2232 2232 0 0 0-.013 8.83 915 915 0 0 1-.013 4.237 804 804 0 0 0 0 5.925l-.005 3.407c.043 2.989.043 2.989 2.247 5.777 2.874.958 4.698 1.132 7.683 1.145l2.873.02 3.096.003 3.187.01q3.338.007 6.675.007c3.407.002 6.812.02 10.218.04q3.242.005 6.483.005l3.09.022 2.882-.01 2.53.005C72.25 86.973 73.85 86.354 76 85c1.376-2.753 1.135-4.973 1.145-8.054l.02-3.853.003-4.183.01-4.274q.009-4.483.007-8.966c0-3.831.014-7.662.031-11.494q.015-4.414.013-8.83 0-2.118.013-4.237c.01-1.975.006-3.95 0-5.925l.005-3.407C77.204 18.788 77.204 18.788 75 16c-2.885-.962-4.986-1.227-8-1.312l-2.625-.114c-2.535.191-2.535.191-4 2.383L59 19c-3.681 1.227-7.104 1.184-10.937 1.188l-2.17.037c-6.8.019-6.8.019-9.893-2.225l-2-3c-2.297-.44-2.297-.44-4.875-.312l-2.617.011c-2.63.316-4.28.888-6.508 2.301"
                                Fill="Black">
                                <Path.LayoutTransform>
                                    <ScaleTransform ScaleX="0.35" ScaleY="0.35"/>
                                </Path.LayoutTransform>
                            </Path>
                        </Canvas>
                    </StackPanel>
                </Button>
            </Grid>
            <GroupBox Header="Export Options" Grid.Column="0" Margin="0,10,5,0" Padding="8">
                <StackPanel>
                    <CheckBox x:Name="SplitPCCheckBox" IsChecked="True" Content="Split P/C Revisions"/>
                </StackPanel>
            </GroupBox>
            <!-- Description text -->
            <StackPanel VerticalAlignment="Center" Margin="0,10,0,5">
                <TextBlock TextWrapping="WrapWithOverflow">
                    Preview of revision data and file naming
                </TextBlock>
            </StackPanel>
        </StackPanel>


        <!-- Status Bar at Bottom -->
        <StatusBar DockPanel.Dock="Bottom" Height="25" Background="{DynamicResource pyRevitDarkBrush}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="10,0,0,0" Foreground="White">
        <!-- Bold static prefix -->
        <Run Text="Naming Format: " FontWeight="Bold"/>
        <!-- Dynamic text -->
        <Run x:Name="NamingFormatText" Text="Selected naming format will appear here"/>
            </TextBlock>
        </StatusBar>

        <!-- DataGrid -->
        <DataGrid x:Name="PreviewDataGrid"
                  AutoGenerateColumns="False"
                  Margin="10,0,10,10"
                  BorderThickness="1"
                  RowHeaderWidth="0"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  IsReadOnly="True"
                  HorizontalGridLinesBrush="#dedede"
                  VerticalGridLinesBrush="#dedede"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  CellStyle="{StaticResource CenteredCellStyle}"
                  GridLinesVisibility="All">
            <DataGrid.Background>
                <DrawingBrush 
                Stretch="Uniform"
                Drawing="{Binding Source={StaticResource my_svg_image}, Path=Drawing}" />
            </DataGrid.Background>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#80FFFFFF"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Sheet Number" Binding="{Binding number}" MinWidth="100" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sheet Name" Binding="{Binding name}" MinWidth="400" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="File Name" FontFamily="Consolas" Binding="{Binding filename}" MinWidth="300" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>


</Window>
