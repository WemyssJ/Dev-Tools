<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Check Spelling" Height="750" Width="660"
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="160"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Context label -->
    <TextBlock Grid.Row="0" Text="Context:" FontWeight="Bold" Margin="0,0,0,6"/>

    <!-- Context preview (RichTextBox for bold/red) -->
    <RichTextBox x:Name="context_box" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>

    <!-- Not in Dictionary -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
      <TextBlock Text="Not in Dictionary:" VerticalAlignment="Center" Width="130"/>
      <TextBox x:Name="word_box" Width="360" IsReadOnly="True"/>
    </StackPanel>

    <!-- Change to -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
      <TextBlock Text="Change to:" VerticalAlignment="Center" Width="130"/>
      <TextBox x:Name="change_to" Width="360"/>
    </StackPanel>

    <!-- Suggestions -->
    <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,10,0,0">
      <TextBlock Text="Suggestions:" Margin="0,0,0,4" FontWeight="Bold"/>
      <ListBox x:Name="suggestions_list" Height="140" SelectionChanged="on_select_suggestion"/>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Ignore" Width="80" Margin="2" Click="do_ignore"/>
      <Button Content="Ignore All" Width="95" Margin="2" Click="do_ignore_all"/>
      <Button Content="Add" Width="70" Margin="2" Click="do_add"/>
      <Button Content="Change" Width="85" Margin="2" Click="do_change"/>
      <Button Content="Change All" Width="100" Margin="2" Click="do_change_all"/>
      <Button Content="Undo" Width="80" Margin="2" Click="do_undo"/>
      <Button Content="Close" Width="80" Margin="2" Click="do_close"/>
    </StackPanel>

  </Grid>
</Window>
