<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trim/Extend Beams" Height="480" Width="575"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

  <DockPanel Margin="10">

    <!-- Top Banner -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48" Background="#0078D7" Margin="0,0,0,10">
        <TextBlock Text="Trim/Extend" FontSize="16" FontWeight="Bold" Margin="10,10,6,10" VerticalAlignment="Center" Foreground="White"/>
        <TextBlock Text="Trim or Extend Beams to Reference" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
    </StackPanel>

    <!-- Action Buttons -->
    <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,10" CornerRadius="6" Background="White" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Steps:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <!-- Step 1: Select beams -->
            <Button x:Name="selectBeamsBtn" Width="500" Height="36" Margin="0,0,0,8"
                    Background="#E3F2FD" Foreground="#1565C0" FontWeight="SemiBold"
                    BorderBrush="#90CAF9" BorderThickness="1" Cursor="Hand">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="①" Margin="0,0,6,0" FontSize="14"/>
                    <TextBlock Text="Select Structural Beams" />
                    <TextBlock x:Name="beamCountText" Text="Selected: 0" FontStyle="Italic" Foreground="Gray" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- Step 2: Select reference -->
            <Button x:Name="selectRefBtn" Width="500" Height="36" Margin="0,0,0,8"
                    Background="#FFF5E0" Foreground="#B95C00" FontWeight="SemiBold"
                    BorderBrush="#FFC382" BorderThickness="1" Cursor="Hand" IsEnabled="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="②" Margin="0,0,6,0" FontSize="14"/>
                    <TextBlock Text="Select Reference Line / Grid / Beam" />
                    <TextBlock x:Name="refCountText" Text="Selected: 0" FontStyle="Italic" Foreground="Gray" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- Step 3: Options / Run -->
            <Button x:Name="optionsBtn" Width="500" Height="36" Margin="0,0,0,0"
                    Background="#E8F5E9" Foreground="#2E7D32" FontWeight="SemiBold"
                    BorderBrush="#A5D6A7" BorderThickness="1" Cursor="Hand" IsEnabled="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="③" Margin="0,0,6,0" FontSize="14"/>
                    <TextBlock Text="Set Options / Run" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>

    <!-- Options Panel -->
    <Border x:Name="optionsPanel" DockPanel.Dock="Top" Padding="18" Margin="0,0,0,10" Background="White"
            CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Visibility="Collapsed">
        <StackPanel>
            <TextBlock Text="Options:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
            
            <CheckBox x:Name="preserveZBox" Content="Preserve Z coordinate (maintains current elevation)"
                      IsChecked="True" Margin="0,0,0,4"
                      ToolTip="When checked, beam Z elevation is preserved. When unchecked, slope is maintained." />

            <CheckBox x:Name="disallowJoinBox" Content="Disallow joins (safer)"
                      IsChecked="True" Margin="0,0,0,4"
                      ToolTip="When checked, auto-joins at beam ends are disabled before trimming/extending." />

            <Button x:Name="runBtn" Width="140" Height="32" Margin="0,10,0,0"
                    Background="#0078D7" Foreground="White" FontWeight="SemiBold"
                    BorderBrush="#005A9E" BorderThickness="1" Cursor="Hand"
                    HorizontalAlignment="Left" Content="▶ Run Trim/Extend"/>
        </StackPanel>
    </Border>

    <!-- Close Button -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
        <Button x:Name="closeBtn" Width="90" Height="28" Margin="5" Content="Close"
                Background="#EEE" Foreground="#222" BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
    </StackPanel>

  </DockPanel>
</Window>
