<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDY-ProTools Toolbar Colours"
        Height="900" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">
        <!-- Top Banner -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48"
                    Background="#0078D7" Margin="0,0,0,10">
            <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
            <TextBlock Text="Toolbar Colours" FontSize="16" FontWeight="Bold"
                       Margin="10,10,6,10" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>

        <!-- Extension Selection -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Select Extension:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="extensionComboBox" Width="300"/>
        </StackPanel>

        <!-- Panel Grid Container -->
        <StackPanel x:Name="panelGridContainer" Margin="0,0,0,12"/>

        <!-- Main Buttons + Previews -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Vertical" >

            <!-- Light -->
            <Button x:Name="btnLight" Content="Apply Light Mode Colours" Height="36" Margin="0,0,0,4"/>
            <Border Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8">
                <ScrollViewer Height="140" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="lightPreviewContainer"/>
                </ScrollViewer>
            </Border>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#DDD" Margin="0,0,0,8"/>

            <!-- Dark -->
            <Button x:Name="btnDark" Content="Apply Dark Mode Colours" Height="36" Margin="0,0,0,4"/>
            <Border Background="#3B4453" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8">
                <ScrollViewer Height="140" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="darkPreviewContainer"/>
                </ScrollViewer>
            </Border>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#DDD" Margin="0,0,0,8"/>

            <!-- Custom -->
            <Button x:Name="btnCustom" Content="Apply Custom Colours" Height="36" Margin="0,0,0,4"/>
            <Border Background="#EFEFEF" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8">
                <ScrollViewer Height="140" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="customPreviewContainer"/>
                </ScrollViewer>
            </Border>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#DDD" Margin="0,0,0,8"/>

            <!-- None -->
            <Button x:Name="btnNone" Content="Remove All Colours" Height="36" Margin="0,0,0,4"/>

        </StackPanel>

        <!-- Reload Button -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button x:Name="btnReloadPyRevit" Width="200" Height="36" Margin="5" Content="Reload pyRevit with New Colours"/>
            <Button x:Name="closeBtn" Width="90" Height="28" Margin="5" Content="Close"/>
        </StackPanel>
    </DockPanel>
</Window>
