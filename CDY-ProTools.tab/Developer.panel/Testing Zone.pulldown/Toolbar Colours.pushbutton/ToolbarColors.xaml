<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDY-ProTools Toolbar Colors"
        Height="660" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">
        <!-- Top Banner -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48"
                    Background="#0078D7" Margin="0,0,0,10">
            <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
            <TextBlock Text="Toolbar Colors" FontSize="16" FontWeight="Bold"
                       Margin="10,10,6,10" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>

        <!-- Main Buttons + Previews -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Vertical" >

            <!-- Light Mode -->
            <Button x:Name="btnLight" Content="Apply Light Mode Colors" Height="36" Margin="0,0,0,4"/>
            <Border Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="140">
                    <StackPanel x:Name="lightPreviewContainer" Orientation="Vertical"/>
                </ScrollViewer>
            </Border>

            <!-- Dark Mode -->
            <Button x:Name="btnDark" Content="Apply Dark Mode Colors" Height="36" Margin="0,0,0,4"/>
            <Border Background="#3B4453" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="140">
                    <StackPanel x:Name="darkPreviewContainer" Orientation="Vertical"/>
                </ScrollViewer>
            </Border>

            <!-- No Colors -->
            <Button x:Name="btnNone" Content="Remove All Colors" Height="36" Margin="0,0,0,4"/>

        </StackPanel>

        <!-- Close Button -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button x:Name="closeBtn" Width="90" Height="28" Margin="5"
                    Content="Close"/>
        </StackPanel>
    </DockPanel>
</Window>
