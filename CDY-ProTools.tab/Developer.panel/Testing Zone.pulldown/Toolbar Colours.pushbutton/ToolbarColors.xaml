<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDY-ProTools Toolbar Colors"
        Height="360" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="NoResize"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">

        <!-- Top Banner -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48"
                    Background="#0078D7" Margin="0,0,0,10">
            <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
            <TextBlock Text="Toolbar Colors" FontSize="16" FontWeight="Bold"
                       Margin="10,10,6,10" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>

        <!-- Main Action Block -->
        <Border DockPanel.Dock="Top" Padding="14" Margin="0,0,0,10"
                CornerRadius="6" Background="White"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Choose Theme:" FontWeight="Bold"
                           FontSize="14" Margin="0,0,0,10"/>

                <!-- Light Mode -->
                <Button x:Name="btnLight" Width="420" Height="36" Margin="0,0,0,8"
                        Background="#E3F2FD" Foreground="#1565C0"
                        FontWeight="SemiBold"
                        BorderBrush="#90CAF9" BorderThickness="1" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Apply Light Mode Colors"/>
                    </StackPanel>
                </Button>

                <!-- Dark Mode -->
                <Button x:Name="btnDark" Width="420" Height="36" Margin="0,0,0,8"
                        Background="#ECE8F5" Foreground="#4527A0"
                        FontWeight="SemiBold"
                        BorderBrush="#B39DDB" BorderThickness="1" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Apply Dark Mode Colors"/>
                    </StackPanel>
                </Button>

                <!-- Remove Colors -->
                <Button x:Name="btnNone" Width="420" Height="36"
                        Background="#FFF5E0" Foreground="#B95C00"
                        FontWeight="SemiBold"
                        BorderBrush="#FFC382" BorderThickness="1" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Remove All Colors"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- Close Button -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="closeBtn" Width="90" Height="28" Margin="5"
                    Content="Close"
                    Background="#EEE" Foreground="#222"
                    BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

    </DockPanel>
</Window>
