<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top">

            <!-- Spacing Input -->
            <TextBlock Text="Spacing (mm):" Margin="0,0,0,5"/>
            <ComboBox Name="spacingBox" IsEditable="True" Text="200" Margin="0,0,0,10">
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="150"/>
                <ComboBoxItem Content="200"/>
                <ComboBoxItem Content="250"/>
                <ComboBoxItem Content="300"/>
            </ComboBox>

            <!-- Cover Input -->
            <TextBlock Text="Cover (mm):" Margin="0,0,0,5"/>
            <TextBox Name="coverBox" Text="50" Margin="0,0,0,10"/>

            <!-- Buttons -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Name="measureBtn" Content="Measure" Click="measureBtn_Click" Height="30"/>
                <Button Grid.Column="2" Name="clearBtn" Content="Clear" Click="clearBtn_Click" Height="30"/>
            </Grid>

            <!-- Results -->
            <Border Background="#F5F5F5" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Name="distanceText" Text="Distance: —" Margin="0,0,0,2"/>
                    <TextBlock Name="barsText" Text="Bars: —" Margin="0,0,0,2"/>
                    <TextBlock Name="roundedText" Text="Rounded Qty: —" FontWeight="Bold" Foreground="Red" Margin="0,0,0,2"/>
                </StackPanel>
            </Border>

            <Separator Margin="0,0,0,5"/>
            <TextBlock Text="History:" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>

        </StackPanel>

        <!-- Console fills remaining space -->
        <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto">
            <TextBlock Name="consoleText" Foreground="Gray" FontSize="11"
                       FontFamily="Consolas" TextWrapping="Wrap"/>
        </ScrollViewer>

    </DockPanel>

</Page>
