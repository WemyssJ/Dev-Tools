<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's Changed? – Results"
        Height="600" Width="750"
        Background="#FAFAFA" Foreground="#222"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Mona-Sans Light" FontSize="13"
        WindowStyle="ToolWindow"
        Topmost="True">

  <DockPanel Margin="10">
    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48" Background="#0078D7" Margin="0,0,0,10">
      <TextBlock Text="📊" FontSize="26" Margin="10,10,5,10" VerticalAlignment="Center" Foreground="White"/>
      <TextBlock Text="What's Changed – Detailed Results" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
    </StackPanel>

    <!-- Change Summary -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
      <TextBlock x:Name="summaryText" FontSize="13" FontWeight="Bold" Foreground="#333"/>
    </StackPanel>

    <!-- Scrollable Results -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="changesPanel" />
    </ScrollViewer>

    <!-- Bottom Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="closeBtn" Content="Close" Width="100" Height="30" Margin="5"
              Background="#EEE" Foreground="#222" BorderBrush="#CCC" Cursor="Hand"/>
    </StackPanel>
  </DockPanel>
</Window>
