<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's Changed?" Height="525" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FFFAFAFA" Foreground="#FF222222"
        ResizeMode="NoResize"
        Topmost="true"
        FontFamily="Segoe UI" FontSize="13">

  <DockPanel Margin="10">

    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#FF0078D7">
      <TextBlock Text="What's Changed?" FontSize="16" FontWeight="Bold"
                 VerticalAlignment="Center" Foreground="White" Margin="10,0,0,0"/>
    </StackPanel>

    <!-- Bottom Buttons (Save/Load + Cancel/Confirm) -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <!-- Left: Save/Load for Import -->
      <StackPanel x:Name="configButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Visible">
        <Button x:Name="saveConfigBtn" Content="Save Config" Width="100" Height="28" Margin="5" Background="#FFEEEEEE" Foreground="#FF222222"/>
        <Button x:Name="loadConfigBtn" Content="Load Config" Width="100" Height="28" Margin="5" Background="#FFEEEEEE" Foreground="#FF222222"/>
      </StackPanel>

      <!-- Right: Cancel/Confirm -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="cancelBtn" Width="90" Height="28" Margin="5" Content="Cancel" Background="#FFEEEEEE" Foreground="#FF222222"/>
        <Button x:Name="okBtn" Width="90" Height="28" Margin="5" Content="Confirm" Background="#FF0078D7" Foreground="White"/>
      </StackPanel>
    </DockPanel>

    <!-- Action Toggle Buttons -->
    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,20,0,0">
      <TextBlock Text="Select Action:" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ToggleButton x:Name="importToggle" Content="Import JSON" Width="120" Height="35" Margin="5" IsChecked="True"
                      Background="#FFE1F5FE" Foreground="#FF0078D7" FontWeight="SemiBold" BorderBrush="#FF81D4FA" BorderThickness="1"/>
        <ToggleButton x:Name="exportToggle" Content="Export JSON" Width="120" Height="35" Margin="5"
                      Background="#FFFFF3E0" Foreground="#FFFB8C00" FontWeight="SemiBold" BorderBrush="#FFFFB74D" BorderThickness="1"/>
      </StackPanel>
    </StackPanel>

    <!-- Export Form -->
    <Border x:Name="exportForm" DockPanel.Dock="Top" Padding="20" Margin="0,15,0,0" Background="White" CornerRadius="6" BorderBrush="#FFDDDDDD" BorderThickness="1" Visibility="Collapsed">
      <StackPanel>
        <Grid Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Model Source -->
            <RowDefinition Height="Auto"/> <!-- Discipline -->
            <RowDefinition Height="Auto"/> <!-- Rev / Date -->
            <RowDefinition Height="Auto"/> <!-- Job Name -->
            <RowDefinition Height="Auto"/> <!-- Job Number -->
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Export Options:" FontWeight="Bold" Margin="0,0,0,10"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Model Source:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox x:Name="modelSourceBox" Grid.Row="1" Grid.Column="1" Width="250" Height="25"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Discipline:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox x:Name="disciplineBox" Grid.Row="2" Grid.Column="1" Width="250" Height="25"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Rev / Date:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox x:Name="revisionBox" Grid.Row="3" Grid.Column="1" Width="250" Height="25" Text="P00"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Job Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox x:Name="jobBox" Grid.Row="4" Grid.Column="1" Width="250" Height="25" Text="N/A"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Job Number:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox x:Name="jobNumberBox" Grid.Row="5" Grid.Column="1" Width="250" Height="25" Text=""/>
        </Grid>

        <!-- Anticipated filename outside the grid so it can wrap -->
        <TextBlock x:Name="anticipatedFileName" Margin="0,10,0,0" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                  Text=""/>
      </StackPanel>
    </Border>


    <!-- Import Form / Color Pickers -->
    <Border x:Name="importForm" DockPanel.Dock="Top" Padding="20" Margin="0,15,0,0" Background="White" CornerRadius="6" BorderBrush="#FFDDDDDD" BorderThickness="1">
      <Grid Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/> <!-- Header -->
          <RowDefinition Height="Auto"/> <!-- New -->
          <RowDefinition Height="Auto"/> <!-- Moved -->
          <RowDefinition Height="Auto"/> <!-- Changed -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Select Override Colors:" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- New Color -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="New:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <Button x:Name="newColorBtn" Content="Pick" Width="50" Height="25"/>
          <Rectangle x:Name="newRect" Width="40" Height="20" Fill="#FF00FF00" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Moved Color -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Moved:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <Button x:Name="movedColorBtn" Content="Pick" Width="50" Height="25"/>
          <Rectangle x:Name="movedRect" Width="40" Height="20" Fill="#FFFFA500" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Changed Color -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Changed:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <Button x:Name="changedColorBtn" Content="Pick" Width="50" Height="25"/>
          <Rectangle x:Name="changedRect" Width="40" Height="20" Fill="#FF0064FF" Margin="10,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

  </DockPanel>
</Window>
