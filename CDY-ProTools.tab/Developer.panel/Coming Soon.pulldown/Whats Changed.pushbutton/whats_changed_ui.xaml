<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's Changed?" Height="600" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5" Foreground="#FF222222"
        ResizeMode="NoResize"
        Topmost="true"
        FontFamily="Segoe UI" FontSize="13">

  <DockPanel Margin="10">

    <!-- Header -->
    <Border DockPanel.Dock="Top" Height="50" Background="#FF0078D7" CornerRadius="6" Margin="0,0,0,10">
      <TextBlock Text="What's Changed?" FontSize="18" FontWeight="Bold"
                 VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
    </Border>

    <!-- Bottom Buttons -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
      <StackPanel x:Name="configButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Visible">
        <Button x:Name="saveConfigBtn" Content="Save Config" Width="100" Height="30" Margin="5"
                Background="#FFEEEEEE" Foreground="#FF222222" BorderBrush="#FFCCCCCC" BorderThickness="1"/>
        <Button x:Name="loadConfigBtn" Content="Load Config" Width="100" Height="30" Margin="5"
                Background="#FFEEEEEE" Foreground="#FF222222" BorderBrush="#FFCCCCCC" BorderThickness="1"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="cancelBtn" Width="90" Height="30" Margin="5" Content="Cancel"
                Background="#FFEEEEEE" Foreground="#FF222222" BorderBrush="#FFCCCCCC" BorderThickness="1"/>
        <Button x:Name="okBtn" Width="90" Height="30" Margin="5" Content="Confirm"
                Background="#FF0078D7" Foreground="White" BorderBrush="#FF005A9E" BorderThickness="1"/>
      </StackPanel>
    </DockPanel>

    <!-- Action Toggle Buttons -->
    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,10">
      <TextBlock Text="Select Action:" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ToggleButton x:Name="importToggle" Content="Import JSON" Width="130" Height="38" Margin="5" IsChecked="True"
                      Background="#FFE1F5FE" Foreground="#FF0078D7" FontWeight="SemiBold" BorderBrush="#FF81D4FA" BorderThickness="1"/>
        <ToggleButton x:Name="exportToggle" Content="Export JSON" Width="130" Height="38" Margin="5"
                      Background="#FFFFF3E0" Foreground="#FFFB8C00" FontWeight="SemiBold" BorderBrush="#FFFFB74D" BorderThickness="1"/>
      </StackPanel>
    </StackPanel>

    <!-- Export Form -->
    <Border x:Name="exportForm" DockPanel.Dock="Top" Padding="20" Margin="0,0,0,10"
            Background="White" CornerRadius="8" BorderBrush="#FFCCCCCC" BorderThickness="1" 
            Visibility="Collapsed" Effect="{DynamicResource DropShadowEffect}">
      <StackPanel>
        <Grid Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Export Options:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Model Source:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox x:Name="modelSourceBox" Grid.Row="1" Grid.Column="1" Width="250" Height="28"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Discipline:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox x:Name="disciplineBox" Grid.Row="2" Grid.Column="1" Width="250" Height="28"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Rev / Date:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox x:Name="revisionBox" Grid.Row="3" Grid.Column="1" Width="250" Height="28" Text="P00"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Job Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox x:Name="jobBox" Grid.Row="4" Grid.Column="1" Width="250" Height="28" Text="N/A"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Job Number:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox x:Name="jobNumberBox" Grid.Row="5" Grid.Column="1" Width="250" Height="28" Text=""/>
        </Grid>

        <TextBlock x:Name="anticipatedFileName" Margin="0,15,0,0" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Import Form / Color Pickers -->
    <Border x:Name="importForm" DockPanel.Dock="Top" Padding="20" Margin="0,0,0,10"
            Background="White" CornerRadius="8" BorderBrush="#FFCCCCCC" BorderThickness="1">
      <Grid Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Select Override Colors:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="New:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <Button x:Name="newColorBtn" Content="Pick" Width="55" Height="28"/>
          <Rectangle x:Name="newRect" Width="175" Height="24" Fill="#FF00FF00" Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Moved:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <Button x:Name="movedColorBtn" Content="Pick" Width="55" Height="28"/>
          <Rectangle x:Name="movedRect" Width="175" Height="24" Fill="#FFFFA500" Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Changed:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <Button x:Name="changedColorBtn" Content="Pick" Width="55" Height="28"/>
          <Rectangle x:Name="changedRect" Width="175" Height="24" Fill="#FF0064FF" Margin="10,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

  </DockPanel>
</Window>
