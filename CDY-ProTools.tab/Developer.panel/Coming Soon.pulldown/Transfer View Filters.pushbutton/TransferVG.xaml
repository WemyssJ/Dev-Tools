<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Filters" Height="580" Width="1690"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">

        <!-- Top Banner -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#0078D7">
            <Image Name="headerIcon" Width="24" Height="24" Margin="10,8"/>
            <TextBlock Text="View Filter Transfer Tool" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="cancelBtn" Width="90" Height="28" Margin="5" Content="Cancel" 
                    Background="#EEE" Foreground="#222"
                    BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
            <Button Name="okBtn" Width="90" Height="28" Margin="5" Content="Confirm"
                    Background="#0078D7" Foreground="White" FontWeight="SemiBold"
                    BorderBrush="#005A9E" BorderThickness="1" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
        

        <!-- Super-header row -->
        <Border DockPanel.Dock="Top" Height="32" CornerRadius="4" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>  
                    <ColumnDefinition Width="100"/>  
                    <ColumnDefinition Width="100"/>  
                    <ColumnDefinition Width="200"/>  
                    <ColumnDefinition Width="150"/>  
                    <ColumnDefinition Width="150"/>  
                    <ColumnDefinition Width="200"/>  
                    <ColumnDefinition Width="150"/>  
                    <ColumnDefinition Width="150"/>  
                    <ColumnDefinition Width="80"/>   
                    <ColumnDefinition Width="120"/>  
                </Grid.ColumnDefinitions>

                <Rectangle Grid.ColumnSpan="11">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#ffffffff" Offset="0.0"/>
                            <GradientStop Color="#ffffffff" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <TextBlock Grid.Column="3" Grid.ColumnSpan="3"
                           Text="Projection"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold" Foreground="#444"/>
                <TextBlock Grid.Column="6" Grid.ColumnSpan="3"
                           Text="Cut"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold" Foreground="#444"/>
            </Grid>
        </Border>

        <!-- Filters List -->
        <Border CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Background="White">
            <ListView Name="filterList"
                      DockPanel.Dock="Top"
                      SelectionMode="Extended"
                      AlternationCount="2"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Margin="0">

                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEE"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F9F9F9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6F0FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CDE6FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView>

                        <!-- Name -->
                        <GridViewColumn Header="Name" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Enable Filter -->
                        <GridViewColumn Header="Enable Filter" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              IsEnabled="False"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Visibility -->
                        <GridViewColumn Header="Visibility" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Visible}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              IsEnabled="False"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Projection Line -->
                        <GridViewColumn Header="Line" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Canvas Width="80" Height="16">
                                            <Line X1="0" Y1="8" X2="80" Y2="8"
                                                  Stroke="{Binding ProjBrush}"
                                                  StrokeThickness="{Binding ProjWeight}"
                                                  StrokeDashArray="{Binding ProjDashArray}"/>
                                        </Canvas>
                                        <TextBlock Text="{Binding ProjPatternText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Projection Hatch FG -->
                        <GridViewColumn Header="Hatch FG" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="16" BorderBrush="#888" BorderThickness="1" 
                                                Background="{Binding ProjFgBrush}" Margin="2" CornerRadius="2"/>
                                        <TextBlock Text="{Binding ProjFg}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Projection Hatch BG -->
                        <GridViewColumn Header="Hatch BG" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="16" BorderBrush="#888" BorderThickness="1" 
                                                Background="{Binding ProjBgBrush}" Margin="2" CornerRadius="2"/>
                                        <TextBlock Text="{Binding ProjBg}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Cut Line -->
                        <GridViewColumn Header="Line" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Canvas Width="80" Height="16">
                                            <Line X1="0" Y1="8" X2="80" Y2="8"
                                                  Stroke="{Binding CutBrush}"
                                                  StrokeThickness="{Binding CutWeight}"
                                                  StrokeDashArray="{Binding CutDashArray}"/>
                                        </Canvas>
                                        <TextBlock Text="{Binding CutPatternText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Cut Hatch FG -->
                        <GridViewColumn Header="Hatch FG" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="16" BorderBrush="#888" BorderThickness="1" 
                                                Background="{Binding CutFgBrush}" Margin="2" CornerRadius="2"/>
                                        <TextBlock Text="{Binding CutFg}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Cut Hatch BG -->
                        <GridViewColumn Header="Hatch BG" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="16" BorderBrush="#888" BorderThickness="1" 
                                                Background="{Binding CutBgBrush}" Margin="2" CornerRadius="2"/>
                                        <TextBlock Text="{Binding CutBg}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Halftone -->
                        <GridViewColumn Header="Halftone" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Halftone}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              IsEnabled="False"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Transparency -->
                        <GridViewColumn Header="Transparency %" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Transparency}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
