<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Filters" Height="580" Width="1710"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Foreground="#222"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Mona-Sans Light" FontSize="13">

    <DockPanel Margin="10">

        <!-- Top Banner -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#0078D7">
            <Image Source="pack://application:,,,/YourIcon.png" Width="24" Height="24" Margin="10,8"/>
            <TextBlock Text="View Filter Transfer Tool" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="cancelBtn" Width="90" Height="28" Margin="5" Content="Cancel" 
                    Background="#EEE" Foreground="#222"
                    BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
            <Button Name="applyCurrentBtn" Width="160" Height="28" Margin="5" Content="Apply to Current Template"
                    Background="#FFA500" Foreground="White" FontWeight="SemiBold"
                    BorderBrush="#CC8400" BorderThickness="1" Cursor="Hand"/>
            <Button Name="okBtn" Width="90" Height="28" Margin="5" Content="OK" 
                    Background="#0078D7" Foreground="White" FontWeight="SemiBold"
                    BorderBrush="#005A9E" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

        <!-- Filters List -->
        <Border CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Background="White">
            <ListView Name="filterList"
                      DockPanel.Dock="Top"
                      SelectionMode="Extended"
                      AlternationCount="2"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Margin="0">

                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEE"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F9F9F9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6F0FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CDE6FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView>

                        <!-- Name -->
                        <GridViewColumn Header="Name" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Enable Filter -->
                        <GridViewColumn Header="Enable Filter" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Visibility -->
                        <GridViewColumn Header="Visibility" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Projection Line -->
                        <GridViewColumn Header="Line" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Canvas Width="80" Height="16">
                                            <Line X1="0" Y1="8" X2="80" Y2="8"
                                                  Stroke="{Binding ProjBrush}"
                                                  StrokeThickness="{Binding ProjWeight}"
                                                  StrokeDashArray="{Binding ProjDashArray}"/>
                                        </Canvas>
                                        <ComboBox ItemsSource="{Binding LinePatterns}" SelectedItem="{Binding ProjPatternText, Mode=TwoWay}" Width="100" Margin="5,0,0,0"/>
                                        <!-- Color Picker Trigger -->
                                        <Button Width="20" Height="16" Margin="5,0,0,0"
                                                Background="{Binding ProjBrush}"
                                                Click="ProjLineColor_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Projection Hatch FG -->
                        <GridViewColumn Header="Hatch FG" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="16" BorderBrush="#888" BorderThickness="1" 
                                                Background="{Binding ProjFgBrush}" Margin="2" CornerRadius="2"/>
                                        <ComboBox ItemsSource="{Binding FillPatterns}" SelectedItem="{Binding ProjFg, Mode=TwoWay}" Width="90" Margin="5,0,0,0"/>
                                        <Button Width="20" Height="16" Margin="5,0,0,0"
                                                Background="{Binding ProjFgBrush}"
                                                Click="ProjFgColor_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Projection Hatch BG -->
                        <GridViewColumn Header="Hatch BG" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="16" BorderBrush="#888" BorderThickness="1" 
                                                Background="{Binding ProjBgBrush}" Margin="2" CornerRadius="2"/>
                                        <ComboBox ItemsSource="{Binding FillPatterns}" SelectedItem="{Binding ProjBg, Mode=TwoWay}" Width="90" Margin="5,0,0,0"/>
                                        <Button Width="20" Height="16" Margin="5,0,0,0"
                                                Background="{Binding ProjBgBrush}"
                                                Click="ProjBgColor_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Repeat similar blocks for Cut Line, Cut Hatch FG/BG with Buttons for Color -->
                        
                        <!-- Halftone -->
                        <GridViewColumn Header="Halftone" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Halftone, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Transparency -->
                        <GridViewColumn Header="Transparency %" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding TransparencyLevels}" SelectedItem="{Binding Transparency, Mode=TwoWay}" Width="50" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
