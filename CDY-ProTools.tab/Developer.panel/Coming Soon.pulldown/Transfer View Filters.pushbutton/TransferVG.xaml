<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Filters" Height="550" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White" Foreground="Black"
        ResizeMode="CanResize">

    <DockPanel Margin="10">

        <!-- Filters List -->
        <ListView Name="filterList" DockPanel.Dock="Top" Height="450"
                  SelectionMode="Extended" AlternationCount="2"
                  BorderThickness="1" BorderBrush="#CCC">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F7F7F7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#ADD8E6"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <!-- Name -->
                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>

                    <!-- Projection Line -->
                    <GridViewColumn Header="Projection Line" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding ProjBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding ProjLineText}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Projection Hatch Foreground -->
                    <GridViewColumn Header="Proj Hatch FG" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding ProjFgBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding ProjFg}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Projection Hatch Background -->
                    <GridViewColumn Header="Proj Hatch BG" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding ProjBgBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding ProjBg}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Cut Line -->
                    <GridViewColumn Header="Cut Line" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding CutBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding CutLineText}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Cut Hatch Foreground -->
                    <GridViewColumn Header="Cut Hatch FG" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding CutFgBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding CutFg}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Cut Hatch Background -->
                    <GridViewColumn Header="Cut Hatch BG" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding CutBgBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding CutBg}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Halftone -->
                    <GridViewColumn Header="Halftone" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Halftone}" IsEnabled="False" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Transparency -->
                    <GridViewColumn Header="Transparency %" Width="80" DisplayMemberBinding="{Binding Transparency}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="okBtn" Width="80" Height="26" Margin="5" Content="OK"/>
            <Button Name="cancelBtn" Width="80" Height="26" Margin="5" Content="Cancel"/>
        </StackPanel>

    </DockPanel>
</Window>
