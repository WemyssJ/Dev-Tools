<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Filters" Height="550" Width="1560"
        WindowStartupLocation="CenterScreen"
        Background="White" Foreground="Black"
        ResizeMode="CanResize">

    <DockPanel Margin="10">

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="okBtn" Width="80" Height="26" Margin="5" Content="OK"/>
            <Button Name="cancelBtn" Width="80" Height="26" Margin="5" Content="Cancel"/>
        </StackPanel>

        <!-- Super-header row -->
        <Grid DockPanel.Dock="Top" Height="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="Projection" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Grid.Column="4" Grid.ColumnSpan="3" Text="Cut" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
        </Grid>

        <!-- Filters List -->
        <ListView Name="filterList" DockPanel.Dock="Top" SelectionMode="Extended" AlternationCount="2" BorderThickness="1" BorderBrush="#CCC">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F7F7F7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#ADD8E6"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding Name}"/>

                    <!-- Projection Line -->
                    <GridViewColumn Header="Line" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="80" Height="16">
                                        <Line X1="0" Y1="8" X2="80" Y2="8"
                                              Stroke="{Binding ProjBrush}"
                                              StrokeThickness="{Binding ProjWeight}"
                                              StrokeDashArray="{Binding ProjDashArray}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding ProjPatternText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Projection Hatch FG -->
                    <GridViewColumn Header="Hatch FG" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding ProjFgBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding ProjFg}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Projection Hatch BG -->
                    <GridViewColumn Header="Hatch BG" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding ProjBgBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding ProjBg}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Cut Line -->
                    <GridViewColumn Header="Line" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="80" Height="16">
                                        <Line X1="0" Y1="8" X2="80" Y2="8"
                                              Stroke="{Binding CutBrush}"
                                              StrokeThickness="{Binding CutWeight}"
                                              StrokeDashArray="{Binding CutDashArray}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding CutPatternText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Cut Hatch FG -->
                    <GridViewColumn Header="Hatch FG" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding CutFgBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding CutFg}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Cut Hatch BG -->
                    <GridViewColumn Header="Hatch BG" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="16" BorderBrush="Gray" BorderThickness="1" Background="{Binding CutBgBrush}" Margin="2"/>
                                    <TextBlock Text="{Binding CutBg}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Halftone -->
                    <GridViewColumn Header="Halftone" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Halftone}" IsEnabled="False" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Transparency -->
                    <GridViewColumn Header="Transparency %" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Transparency}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
