<Application x:Class="PyRevitXamlDesigner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Fake pyRevit brushes -->
        <SolidColorBrush x:Key="pyRevitAccentBrush" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="pyRevitDarkBrush" Color="#FF333333"/>
        <!-- Fake SystemColors brush so BorderBrush bindings work -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF555555"/>
        <!-- Dummy context menu -->
        <ContextMenu x:Key="ItemContextMenu">
            <MenuItem Header="(Placeholder menu)" />
        </ContextMenu>
    </Application.Resources>
</Application>
